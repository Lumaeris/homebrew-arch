# Maintainer: Jill Fiore <contact@lumaeris.com>
pkgname=homebrew
pkgver=7.0.2 # renovate: datasource=github-releases depName=Homebrew/brew registryUrl=https://github.com/
pkgrel=1
pkgdesc="The Missing Package Manager for macOS (or Linux)"
arch=(x86_64)
url="https://github.com/${pkgname}/brew"
makedepends=('sudo')
depends=('git' 'curl' 'zstd')
optdepends=('brew-proxy: dbus-activated proxy service for secure setup')
provides=('brew' 'homebrew' 'linuxbrew')
conflicts=('brew' 'brew-git' 'linuxbrew' 'linuxbrew-git')
license=('BSD-2-Clause' 'Apache-2.0')
install=${pkgname}.install
source=(ublue-brew::"git+https://github.com/ublue-os/brew.git"
        ${pkgname}::"git+https://github.com/${pkgname}/install.git"
        install.patch)
sha512sums=('SKIP'
            'SKIP'
            '154cbcc12e531db29c53d7f58045a87a9765ff029f3f001d183f8451d78be0fe71c3ab02caeb8a083f17f8e11031e8918b1804dd3d5b0bfcf7376e6e04066419')

prepare() {
    patch < install.patch ${pkgname}/install.sh
}

build() {
    env --ignore-environment "PATH=/usr/bin:/bin:/usr/sbin:/sbin" "HOME=/home/linuxbrew" "NONINTERACTIVE=1" /usr/bin/bash ${pkgname}/install.sh
}

package() {
    cp -a "${srcdir}/ublue-brew/system_files/." "${pkgdir}"
    tar --zstd -cvf "${pkgdir}/usr/share/${pkgname}.tar.zst" "home/linuxbrew/.linuxbrew"
}
